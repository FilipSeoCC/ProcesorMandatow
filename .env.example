# Sekrety Google są używane wyłącznie przez serwer. Nie dodawaj prefiksu NEXT_PUBLIC_.
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_server-only-never-commit

# Document AI and Route Optimization auth via Vercel OIDC Federation (Workload
# Identity Federation) — no service account key, no API key, both blocked by
# org policy / unsupported by these APIs. Route Optimization requires a full
# OAuth2/IAM principal (roles/routeoptimization.viewer), not an API key.
# Requires "Secure Backend Access with OIDC Federation" enabled in Vercel project settings.
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-ocr-processor-id
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_WIF_AUDIENCE=//iam.googleapis.com/projects/your-project-number/locations/global/workloadIdentityPools/your-pool/providers/your-provider

# STILL REQUIRED — only Route Optimization moved to WIF. Address lookup in the
# route planner (/api/routes/geocode) uses the classic Maps Geocoding API,
# which authenticates with an API key. Without this the planner returns 503
# and no delivery address can be added at all.
GOOGLE_MAPS_SERVER_API_KEY=your-maps-geocoding-api-key

# Cron-triggered workers: OCR retry queue and the auto-rematch sweep both
# reject every request unless this matches the Authorization: Bearer header.
CRON_SECRET=generate-a-long-random-value

# E-mail package sent to the employee who verifies and forwards the case.
# These are server-only values; never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=FlotaFlow <mandaty@your-verified-domain.pl>
APP_URL=https://procesor-mandatow.vercel.app

# Production defaults: access is invite-only and route planning must never
# silently return a demo result when Google is unavailable.
ALLOW_PUBLIC_SIGNUP=false
ROUTE_OPTIMIZATION_DEMO_MODE=false
