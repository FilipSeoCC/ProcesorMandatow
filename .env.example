# Sekrety Google są używane wyłącznie przez serwer. Nie dodawaj prefiksu NEXT_PUBLIC_.
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_server-only-never-commit

# Document AI and Route Optimization auth via Vercel OIDC Federation (Workload
# Identity Federation) — no service account key, no API key, both blocked by
# org policy / unsupported by these APIs. Route Optimization requires a full
# OAuth2/IAM principal (roles/routeoptimization.viewer), not an API key.
# Requires "Secure Backend Access with OIDC Federation" enabled in Vercel project settings.
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-ocr-processor-id
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_WIF_AUDIENCE=//iam.googleapis.com/projects/your-project-number/locations/global/workloadIdentityPools/your-pool/providers/your-provider
