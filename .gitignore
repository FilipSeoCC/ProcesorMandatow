# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.pnpm-store/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local dev config (skills are shared with the team, see below —
# mirrors how .codex/ is tracked except for its machine-specific hooks.json)
.claude/*
!.claude/skills/

# Graphify: share the portable knowledge graph between agents, but keep
# machine-specific runtime files, caches, backups and the HTML export local.
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/manifest.json
!/graphify-out/.graphify_analysis.json
!/graphify-out/.graphify_labels.json
!/graphify-out/.graphify_labels.json.sig
/.codex/hooks.json

# local client exports and generated fleet-import files
/client-import/
/import-floty-klienta*.csv
